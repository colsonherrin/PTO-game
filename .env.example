# Copy to .env and fill in. Never commit .env.
OPENROUTER_API_KEY=
# Optional
PORT=5173
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
PTO_MAX_TOKENS=900
PTO_RATE_LIMIT_RPM=40
PTO_SERVER_BUDGET_USD=2
# Comma-separated allow-list; empty = any model
PTO_ALLOWED_MODELS=openai/gpt-oss-20b,openai/gpt-oss-120b
